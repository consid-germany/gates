{
	"name": "@consid-germany/gates-ui",
	"version": "1.4.0",
	"description": "Web frontend providing a user interface to view and toggle gates.",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/consid-germany/gates.git"
	},
	"author": {
		"name": "Consid GmbH",
		"email": "hamburg@consid.com",
		"organization": true
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/consid-germany/gates/issues"
	},
	"homepage": "https://github.com/consid-germany/gates",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"postinstall": "openapi-typescript ./../openapi.yaml -o src/lib/generated/api.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/plus-jakarta-sans": "^5.2.8",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"flowbite-svelte": "^1.33.1",
		"globals": "^17.7.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.61.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	}
}
