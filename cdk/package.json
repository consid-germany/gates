{
  "name": "@consid-germany/gates",
  "description": "AWS CDK construct for deploying the gates API (including the GitHub API) and UI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/consid-germany/gates.git"
  },
  "author": {
    "name": "Consid GmbH",
    "email": "hamburg@consid.com",
    "organization": true
  },
  "homepage": "https://github.com/consid-germany/gates",
  "license": "MIT",
  "version": "1.4.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "prebuild": "npm run copy-readme && npm run copy-builds && npm run build:function",
    "copy-readme": "cd scripts && node copy-readme.ts",
    "copy-builds": "cd scripts && node copy-builds.ts",
    "build:function": "cd src/function && tsc && node build.ts",
    "build": "jsii",
    "build:watch": "jsii -w",
    "package": "jsii-pacmak",
    "lint": "eslint **/*.ts",
    "test": "vitest run",
    "integ-test": "integ-runner --parallel-regions eu-central-1 -v",
    "integ-watch": "integ-runner --parallel-regions eu-central-1 -v --watch",
    "check": "prettier src/**/*.ts --check",
    "format": "prettier src/**/*.ts --write",
    "publish": "publib-npm"
  },
  "bugs": {
    "url": "https://github.com/consid-germany/gates/issues"
  },
  "devDependencies": {
    "@aws-cdk/integ-runner": "^2.202.1",
    "@aws-cdk/integ-tests-alpha": "^2.261.0-alpha.0",
    "@aws-sdk/client-cloudfront": "^3.1080.0",
    "@aws-sdk/client-secrets-manager": "^3.1080.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.0",
    "aws-cdk-lib": "2.265.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "10.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jose": "^6.2.3",
    "jsii": "^6.0.4",
    "jsii-pacmak": "^1.138.0",
    "nock": "^14.0.16",
    "prettier": "^3.9.4",
    "publib": "^0.2.1054",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest-mock-extended": "^4.0.0",
    "wildcard-match": "^5.1.4"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.243.0",
    "constructs": "^10.5.1"
  },
  "jsii": {
    "outdir": "dist",
    "tsc": {
      "rootDir": "src",
      "outDir": "lib"
    },
    "versionFormat": "full",
    "excludeTypescript": [
      "src/function/**/*",
      "src/**/*.test.ts"
    ],
    "targets": {}
  },
  "files": [
    "lib/**/*",
    "build/**/*"
  ],
  "stability": "experimental",
  "publishConfig": {
    "access": "public"
  }
}
